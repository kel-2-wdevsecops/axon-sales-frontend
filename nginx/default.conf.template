# nginx di container FE. File ini template: saat container start, entrypoint
# image nginx menjalankan envsubst dan menulis hasilnya ke
# /etc/nginx/conf.d/default.conf. Hanya variabel yang ADA di environment yang
# diganti (${API_UPSTREAM}, ${NGINX_LOCAL_RESOLVERS}); variabel nginx seperti
# $uri dibiarkan apa adanya.

server_tokens off;

server {
    # nginx-unprivileged berjalan sebagai non-root, jadi port di atas 1024.
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Header keamanan untuk semua respons (`always` = termasuk 4xx/5xx).
    # PENTING: jangan pakai add_header di dalam blok location di bawah. nginx
    # tidak mewariskan add_header ke location yang punya add_header sendiri,
    # sehingga semua header ini hilang di location itu. Cache diatur dengan
    # `expires`, yang bukan add_header.
    # Script DAN style hanya dari origin sendiri, tanpa 'unsafe-inline'.
    # Atribut `style` yang dipasang React/Recharts lewat JavaScript (CSSOM)
    # tidak diatur CSP, jadi grafik tetap jalan. Library baru yang
    # menyuntikkan tag <style> akan diblokir: cek konsol browser.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # API diteruskan ke BE, jadi browser hanya bicara ke satu origin (tanpa
    # CORS, dan FE tidak perlu tahu URL BE saat build). API_UPSTREAM diisi di
    # compose.yaml (http://devsecops_be:3008 di network uts-net). Header
    # CF-Connecting-IP dari Cloudflare ikut diteruskan apa adanya; BE
    # (BEHIND_CLOUDFLARE=true) membaca IP pengunjung dari situ.
    location /api/ {
        # Nama BE di-resolve ulang saat runtime lewat DNS Docker, bukan sekali
        # saat nginx start: tanpa ini nginx gagal start kalau BE belum ada,
        # dan setelah BE di-deploy ulang (IP container baru) FE menjawab 502
        # sampai di-restart. proxy_pass dengan variabel memaksa resolve per
        # request (di-cache 10 detik). NGINX_LOCAL_RESOLVERS diisi entrypoint
        # image dari /etc/resolv.conf (NGINX_ENTRYPOINT_LOCAL_RESOLVERS di
        # Dockerfile). Tanpa path di URL, URI asli (/api/v1/...) diteruskan.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # Host TIDAK diteruskan dari request: nilainya dikendalikan klien. BE
        # tidak memakai Host (URL-nya dari APP_URL), jadi nginx memakai host
        # upstream bawaannya.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        client_max_body_size 1m;
    }

    # Dibaca health check staging & deploy; tidak boleh di-cache.
    location = /version.json {
        expires -1;
    }

    # Hasil build Vite: nama file ber-hash, aman di-cache selamanya.
    location /assets/ {
        expires max;
        access_log off;
        try_files $uri =404;
    }

    # SPA: route apa pun (/produk, /pertumbuhan, ...) dijawab index.html, yang
    # selalu diambil ulang supaya rilis baru langsung terpakai.
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
